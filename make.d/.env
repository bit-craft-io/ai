#COMPOSE_PROJECT_NAME=sandbox
#COMPOSE_IGNORE_ORPHANS=true
# dify に対応するモデル
__OLLAMA_MODEL=llama3.2:3b

__DIFY_SECRET_KEY=local-dev-secret-key-fixed
__DIFY_DB_NAME=dify
__DIFY_DB_USER=postgres
__DIFY_DB_CONTAINER=db_postgres
__DIFY_COMPOSE_FILE=docker/dify/docker/docker-compose.yaml
__DIFY_VOLUMES_DIR=docker/dify/docker/volumes
__DIFY_BACKUP_ROOT=backup
